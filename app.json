{
  "expo": {
    "name": "E-MP ASI SMAD",
    "slug": "empasi-smad",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.empasismad.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser",
      "expo-font",
      "expo-audio",
      "expo-asset"
    ],
    "owner": "fhazar_aqyla",
    "extra": {
      "eas": {
        "projectId": "a75ff5d1-9dcb-4cce-a7db-f882294688fd"
      }
    }
  }
}
